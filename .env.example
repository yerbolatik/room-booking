# ── Django ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
# DEBUG is controlled by DJANGO_SETTINGS_MODULE, not this file:
#   config.settings.development  -> DEBUG=True
#   config.settings.production   -> DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=room_booking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── JWT ──────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_DAYS=1
REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Superuser (created on first boot if none exists) ──────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-strong-password

# ── Gunicorn (optional tuning) ────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
